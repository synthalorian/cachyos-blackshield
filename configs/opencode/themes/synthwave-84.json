{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bgDeep": "#240037",
    "bgPanel": "#360052",
    "bgElement": "#4B0080",
    "purple": "#8F00FF",
    "magenta": "#FF00FF",
    "hotPink": "#FF7EDB",
    "yellow": "#F3E70F",
    "softYellow": "#FEDE5D",
    "cyan": "#03EDF9",
    "green": "#72F1B8",
    "red": "#FE4450",
    "lavender": "#B084EB",
    "dimBlue": "#495495",
    "white": "#FFFFFF",
    "diffAddedBg": "#14392B",
    "diffRemovedBg": "#4A1030",
    "diffContextBg": "#2E0047"
  },
  "theme": {
    "primary": "hotPink",
    "secondary": "purple",
    "accent": "cyan",
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "lavender",

    "text": "hotPink",
