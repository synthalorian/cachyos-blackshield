{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/blackshield-shield.txt",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 6
    }
  },
  "display": {
    "separator": " \u25aa ",
    "color": {
      "keys": "#C1121F",
      "title": "#E5383B",
      "separator": "#52525E",
      "output": "#D8D3C8"
    },
    "brightColor": true,
    "percent": {
      "type": 3
    },
    "bar": {
      "char": {
        "elapsed": "\u25aa",
        "total": "-"
      },
      "width": 15
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#1;38;2;229;56;59}{user-name}{#separator}@{#1;38;2;216;211;200}{host-name}{#}"
    },
    {
      "type": "separator",
      "string": "\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa\u25aa"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "host",
      "key": "HOST",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "kernel",
      "key": "KERNEL",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "uptime",
      "key": "UPTIME",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "packages",
      "key": "PKGS",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "shell",
      "key": "SHELL",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "display",
      "key": "DISPLAY",
      "keyColor": "#C1121F",
      "compactType": "original-with-refresh-rate",
      "keyWidth": 11
    },
    {
      "type": "de",
      "key": "DE",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "theme",
      "key": "THEME",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "icons",
      "key": "ICONS",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "font",
      "key": "FONT",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "cursor",
      "key": "CURSOR",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "terminal",
      "key": "TERM",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    {
      "type": "terminalfont",
      "key": "TERMFONT",
      "keyColor": "#C1121F",
      "keyWidth": 11
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#C9A227",
      "keyWidth": 11
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#C9A227",
      "keyWidth": 11
    },
    {
      "type": "memory",
      "key": "MEM",
      "keyColor": "#C9A227",
      "keyWidth": 11
    },
    {
      "type": "swap",
      "key": "SWAP",
      "keyColor": "#C9A227",
      "keyWidth": 11
    },
    {
      "type": "disk",
      "key": "DISK",
      "keyColor": "#C9A227",
      "folders": "/",
      "keyWidth": 11
    },
    {
      "type": "battery",
      "key": "BATT",
      "keyColor": "#C9A227",
      "keyWidth": 11
    },
    "break",
    {
      "type": "colors",
      "key": "COLORS",
      "keyColor": "#C1121F",
      "symbol": "circle",
      "keyWidth": 11
    }
  ]
}