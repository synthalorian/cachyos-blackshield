# RTL8822BE WiFi resurrection — 2026-08-12
# The card does not enumerate on the normal boot path (kernel PCI probe
# fails to discover it). This oneshot triggers a PCI bus rescan early in
# boot, before NetworkManager starts, and verifies the device comes back.
#
# Copy to /etc/systemd/system/wifi-resurrect.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable wifi-resurrect.service
#
# CUSTOMIZE BEFORE DEPLOYING:
#   - ExecStart path → wherever you placed wifi-resurrect.sh
#   - The script hardcodes slot 0000:04:00.0, vendor 0x10ec, device 0xb822
#     (RTL8822BE). Adjust all three if the target card differs.
#   - If=NetworkManager.service — drop or retarget if not using NM.
#
# Undo: sudo systemctl disable --now wifi-resurrect.service
# Logs: journalctl -t wifi-resurrect

[Unit]
Description=Resurrect RTL8822BE WiFi via PCI rescan
Documentation=man:lspci(8)
After=local-fs.target
Before=NetworkManager.service
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/home/synth/.hermes/skills/cachyos/linux-hardware-troubleshooting/scripts/wifi-resurrect.sh
RemainAfterExit=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wifi-resurrect

[Install]
WantedBy=sysinit.target
